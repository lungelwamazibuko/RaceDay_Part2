@model RaceDay_Part2.Models.TblCategory

@{
    ViewData["Title"] = "Delete Category";
}

<h4>Delete Category</h4>
<hr />

<div>
    <h5>@Model.CategoryName</h5>
    <dl class="row">
        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Model?.Event?.EventName ?? "—"</dd>

        <dt class="col-sm-2">Route</dt>
        <dd class="col-sm-10">@Model?.Route?.RouteName ?? "—"</dd>

        <dt class="col-sm-2">Gender</dt>
        <dd class="col-sm-10">@Model.Gender</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CategoryId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
