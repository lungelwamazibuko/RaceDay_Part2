@model IEnumerable<RaceDay_Part2.Models.TblCategory>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

@if (ViewBag.DbIssue != null)
{
    <div class="alert alert-warning">
        <strong>Database problem:</strong> @ViewBag.DbIssue
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Category</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No categories found.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Category</th>
                <th>Event</th>
                <th>Route</th>
                <th>Gender</th>
                <th>Min Age</th>
                <th>Max Age</th>
                <th>Distance (km)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(_ => item.CategoryName)</td>
                    <td>@(item.Event?.EventName ?? "—")</td>
                    <td>@(item.Route?.RouteName ?? "—")</td>
                    <td>@item.Gender</td>
                    <td>@item.MinimumAge</td>
                    <td>@item.MaximumAge</td>
                    <td>@(item.DistanceKm?.ToString("0.##") ?? "—")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-link">View</a>
                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
