@model List<RaceDay_Part2.Models.ViewModels.ManageUserRolesViewModel>

@{
    var userId = ViewBag.userId as string;
    var userName = ViewBag.UserName as string;
}

<form id="rolesForm" method="post" asp-controller="UserRoles" asp-action="UpdateRolesAjax">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@userId" />

    <div class="mb-2">
        <strong>Manage roles for:</strong> @userName
    </div>

    <div class="list-group">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="form-check m-1">
                <input type="hidden" asp-for="@Model[i].RoleId" />
                <input type="hidden" asp-for="@Model[i].RoleName" />
                <input class="form-check-input" type="checkbox" asp-for="@Model[i].isSelected" id="role_@i" />
                <label class="form-check-label" for="role_@i">@Model[i].RoleName</label>
            </div>
        }
    </div>

    <div class="mt-3 text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>